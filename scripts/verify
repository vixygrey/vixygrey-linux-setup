#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
temporary_directories=()

cleanup() {
  local directory
  for directory in "${temporary_directories[@]}"; do
    rm -rf -- "$directory"
  done
}

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Required verification tool is missing: %s\n' "$1" >&2
    exit 2
  fi
}

smoke_preview() {
  local expected=0
  if [[ "${1:-}" == --expect=* ]]; then
    expected="${1#--expect=}"
    shift
  fi
  local temporary brew_cache status
  temporary="$(mktemp -d "${TMPDIR:-/tmp}/vixygrey-setup-verify.XXXXXX")"
  temporary_directories+=("$temporary")
  brew_cache="$(mktemp -d "${TMPDIR:-/tmp}/vixygrey-setup-verify.XXXXXX")"
  temporary_directories+=("$brew_cache")
  if env HOME="$temporary" \
    XDG_CONFIG_HOME="$temporary/.config" \
    XDG_DATA_HOME="$temporary/.local/share" \
    HOMEBREW_CACHE="$brew_cache" \
    PYTHONDONTWRITEBYTECODE=1 \
    "$ROOT/setup.sh" "$@"; then
    status=0
  else
    status=$?
  fi
  if [[ "$status" -ne "$expected" ]]; then
    printf 'Preview returned %s, expected %s\n' "$status" "$expected" >&2
    exit 2
  fi
  if [[ -n "$(find "$temporary" -mindepth 1 -print -quit)" ]]; then
    printf 'Preview wrote to temporary home: %s\n' "$temporary" >&2
    exit 2
  fi
}

trap cleanup EXIT

for tool in npm python3 zsh shellcheck shfmt; do
  require "$tool"
done

if ! python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
  printf '%s\n' 'Python 3.11+ is required for verification.' >&2
  exit 2
fi

cd -- "$ROOT"
npm run format:check
./scripts/format-python --check
"$ROOT/.venv/bin/ruff" check --no-cache setup.py archives.py app_files.py safe_files.py scripts/validate-palette.py tests
./scripts/format-shell --check
compile_cache="$(mktemp -d "${TMPDIR:-/tmp}/vixygrey-setup-verify.XXXXXX")"
temporary_directories+=("$compile_cache")
PYTHONPYCACHEPREFIX="$compile_cache/pycache" python3 -m py_compile setup.py archives.py app_files.py safe_files.py scripts/validate-palette.py
python3 -B scripts/validate-palette.py
python3 -B -m unittest discover -s tests -v
zsh -n dotfiles/.zshrc dotfiles/.config/vixygrey/setup.zsh
shellcheck setup.sh scripts/format-python scripts/format-shell scripts/verify
./setup.sh --validate-catalog >/dev/null
./setup.sh --list >/dev/null
smoke_preview --apps-only --only omp --trust omp
smoke_preview --theme-only
smoke_preview --expect=2 --apps-only --profile ai
smoke_preview --status --apps-only --only omp --trust omp --format json
smoke_preview --doctor --format json
printf '%s\n' 'Verification passed.'
