#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
RUFF="$ROOT/.venv/bin/ruff"

if [[ ! -x "$RUFF" ]]; then
  printf '%s\n' 'Ruff is unavailable. Run: uv sync --locked --group dev' >&2
  exit 2
fi

case "${1:-}" in
--check)
  "$RUFF" format --check "$ROOT/setup.py" "$ROOT/archives.py" "$ROOT/safe_files.py" "$ROOT/app_files.py" "$ROOT/scripts/validate-palette.py" "$ROOT/tests"
  ;;
--write)
  "$RUFF" format "$ROOT/setup.py" "$ROOT/archives.py" "$ROOT/safe_files.py" "$ROOT/app_files.py" "$ROOT/scripts/validate-palette.py" "$ROOT/tests"
  ;;
*)
  printf '%s\n' "Usage: $0 --check|--write" >&2
  exit 2
  ;;
esac
